# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/iyknel?schema=public"

# --- NextAuth ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Email (nodemailer) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"Iyknel\" <no-reply@example.com>"

# --- SMS (BulkSMS Nigeria) ---
BULKSMS_NG_API_TOKEN=""
BULKSMS_NG_SENDER_ID="Iyknel"

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# --- Business config ---
ADMIN_NOTIFY_EMAIL="orders@example.com"
# Optional: admin phone for SMS alerts on new orders and declared payments.
# Leave unset to disable admin SMS (email + in-app alerts still fire).
ADMIN_NOTIFY_PHONE=""
CONTACT_EMAIL="orders@example.com"
# Comma-separated list of phone numbers. Local 0XXXXXXXXXX or +234XXXXXXXXXX both work.
# Example: "08182806282,08114499558". Leave unset to use the built-in defaults.
CONTACT_PHONE=""
# Digits only (no +), e.g. 2348012345678. Used for wa.me links.
CONTACT_WHATSAPP=""
# Office address (defaults match the Iyknel head office; override per environment).
CONTACT_ADDRESS_LINE1=""
CONTACT_ADDRESS_LINE2=""
CONTACT_ADDRESS_LGA=""
CONTACT_ADDRESS_STATE=""
BANK_NAME=""
BANK_ACCOUNT_NAME=""
BANK_ACCOUNT_NUMBER=""

# --- Seed (used by prisma db seed) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme-on-first-login"
