// Iyknel B2B FMCG e-commerce schema.
// Conventions:
//   - All money in kobo (Int). All weights in grams (Int).
//   - Order lines snapshot price + weight at submission.
//   - Stock is derived from StockMovement (Product.stock is a cached projection).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  phone         String?
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business      Business?
  addresses     Address[]
  cart          Cart?
  wishlist      Wishlist?
  orders        Order[]
  passwordCodes PasswordResetCode[]
  auditLogs     AuditLog[]    @relation("AuditActor")
  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  quoteResponses QuoteRequest[] @relation("QuoteResponder")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  channel   String   // "sms" | "email"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Business profile ----------

model Business {
  id           String   @id @default(cuid())
  userId       String   @unique
  name         String
  rcNumber     String?
  contactName  String
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  country    String  @default("Nigeria")
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
}

// ---------- Catalog ----------

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  sortOrder   Int       @default(100)
  active      Boolean   @default(true)
  products    Product[]

  @@index([sortOrder, name])
}

model Product {
  id          String        @id @default(cuid())
  sku         String        @unique
  slug        String        @unique
  name        String
  description String?
  priceKobo        Int
  weightGrams      Int
  unitsPerCarton   Int?
  stockCartons     Int           @default(0)
  stockLoosePieces Int           @default(0)
  images      String[]      @default([])
  active      Boolean       @default(true)
  featured    Boolean       @default(false)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  movements     StockMovement[]
  reviews       Review[]

  @@index([categoryId])
  @@index([featured, active])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  body      String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, createdAt])
  @@index([productId, published])
}

// ---------- Cart / Wishlist ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id              String  @id @default(cuid())
  cartId          String
  productId       String
  quantityCartons Int     @default(0)
  quantityPieces  Int     @default(0)
  cart            Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Wishlist {
  id     String         @id @default(cuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  addedAt    DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([wishlistId, productId])
}

// ---------- Orders ----------

enum OrderStatus {
  DRAFT
  SUBMITTED
  AWAITING_APPROVAL
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  PAID
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Order {
  id              String       @id @default(cuid())
  number          String       @unique
  userId          String
  status          OrderStatus  @default(SUBMITTED)
  addressId       String?
  distanceBandId  String?
  vehicleId       String?
  tripCount       Int          @default(1)
  subtotalKobo    Int          @default(0)
  logisticsKobo   Int          @default(0)
  totalKobo       Int          @default(0)
  weightGrams     Int          @default(0)
  notes           String?
  cancelReason    String?
  submittedAt     DateTime     @default(now())
  approvedAt      DateTime?
  paidAt          DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  updatedAt      DateTime     @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  address        Address?      @relation(fields: [addressId], references: [id])
  distanceBand   DistanceBand? @relation(fields: [distanceBandId], references: [id])
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id])
  items          OrderItem[]
  invoice        Invoice?
  payments       Payment[]
  movements      StockMovement[]
  auditLogs      AuditLog[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  productId          String
  nameSnapshot       String
  skuSnapshot        String
  priceKoboSnap      Int
  weightGramsSnap    Int
  quantityCartons    Int     @default(0)
  quantityPieces     Int     @default(0)
  unitsPerCartonSnap Int?
  quantity           Int
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product @relation(fields: [productId], references: [id])
}

enum InvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  orderId       String        @unique
  status        InvoiceStatus @default(ISSUED)
  subtotalKobo  Int
  logisticsKobo Int
  totalKobo     Int
  pdfKey        String?
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String    @id @default(cuid())
  orderId      String
  amountKobo   Int
  bankRef      String?
  proofUrl     String?
  declaredAt   DateTime  @default(now())
  verifiedAt   DateTime?
  verifiedById String?
  notes        String?
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------- Logistics ----------

model Vehicle {
  id          String          @id @default(cuid())
  name        String          @unique
  tonnageKg   Int
  fuelPerKm   Decimal         @db.Decimal(10, 3)
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  costs       LogisticsCost[]
  orders      Order[]
}

model DistanceBand {
  id        String          @id @default(cuid())
  label     String          @unique
  minKm     Int
  maxKm     Int
  sortOrder Int             @default(0)
  active    Boolean         @default(true)
  costs     LogisticsCost[]
  orders    Order[]
}

model LogisticsCost {
  id             String       @id @default(cuid())
  vehicleId      String
  distanceBandId String
  costKobo       Int
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  distanceBand   DistanceBand @relation(fields: [distanceBandId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, distanceBandId])
}

// ---------- Inventory audit ----------

enum StockReason {
  RESTOCK
  BULK_UPLOAD
  ORDER
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id           String      @id @default(cuid())
  productId    String
  deltaCartons Int         @default(0)
  deltaPieces  Int         @default(0)
  reason       StockReason
  orderId      String?
  note         String?
  createdAt    DateTime    @default(now())
  product      Product     @relation(fields: [productId], references: [id])
  order        Order?      @relation(fields: [orderId], references: [id])

  @@index([productId])
}

// ---------- Audit log ----------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  orderId   String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// ---------- Quote requests (public, unauthenticated) ----------

enum QuoteStatus {
  PENDING
  RESPONDED
  CLOSED
}

model QuoteRequest {
  id            String      @id @default(cuid())
  businessName  String
  contactName   String
  email         String
  phone         String
  message       String
  status        QuoteStatus @default(PENDING)
  responseBody  String?
  respondedAt   DateTime?
  respondedById String?
  respondedBy   User?       @relation("QuoteResponder", fields: [respondedById], references: [id])
  closedAt      DateTime?
  closedReason  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
}
