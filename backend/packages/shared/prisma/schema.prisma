generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH SCHEMA
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(BUYER)
  buyerId       String?   @unique
  buyer         Buyer?    @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

enum UserRole {
  ADMIN
  SALES_MANAGER
  WAREHOUSE_STAFF
  SALES_REP
  BUYER
}

// ============================================
// BUYER SCHEMA
// ============================================

model Buyer {
  id                    String          @id @default(cuid())
  companyName           String
  registrationNumber    String          @unique
  businessType          BuyerCategory
  email                 String          @unique
  phone                 String
  contactPerson         String
  approvalStatus        ApprovalStatus  @default(PENDING)
  approvalDate          DateTime?
  approvedByAdminId     String?
  kycDocuments          KYCDocument[]
  addresses             DeliveryAddress[]
  pricingTier           PricingTier     @default(STANDARD)
  customPricingAllowed  Boolean         @default(false)
  creditLimit           Float           @default(0)
  creditUsed            Float           @default(0)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User?
  orders    Order[] 
  
   
  @@index([businessType])
  @@index([approvalStatus])
  @@index([pricingTier])
}

enum BuyerCategory {
  RETAILER
  SUPERMARKET
  DISTRIBUTOR
  INSTITUTION
  HOTEL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PricingTier {
  STANDARD
  GOLD
  PLATINUM
  ENTERPRISE
}

model KYCDocument {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  docType   String
  docUrl    String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([buyerId])
}

model DeliveryAddress {
  id        String  @id @default(cuid())
  buyerId   String
  buyer     Buyer   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  label     String
  address   String
  city      String
  state     String
  zipCode   String
  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)

  @@index([buyerId])
}

// ============================================
// PRODUCT & CATALOG SCHEMA
// ============================================

model Product {
  id              String    @id @default(cuid())
  sku             String    @unique
  name            String
  description     String?
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  subcategoryId   String?
  subcategory     SubCategory? @relation(fields: [subcategoryId], references: [id])
  imageUrl        String?
  basePrice       Float
  packSize        Int       @default(1)
  cartonQuantity  Int       @default(12)
  minOrderQty     Int       @default(1)
  weight          Float?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  inventoryLevels InventoryLevel[]
  variants        ProductVariant[]
  pricingRules    PricingRule[]
  orderItems      OrderItem[]

  @@index([sku])
  @@index([categoryId])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  products Product[]
  subcategories SubCategory[]
}

model SubCategory {
  id         String @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, name])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   String
  value     String
  priceAdjustment Float @default(0)

  @@unique([productId, variant, value])
  @@index([productId])
}

// ============================================
// PRICING SCHEMA
// ============================================

model PricingRule {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity     Int
  maxQuantity     Int?
  pricePerUnit    Float
  buyerCategory   BuyerCategory?
  pricingTier     PricingTier?
  discount        Float   @default(0)
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, minQuantity, buyerCategory, pricingTier])
  @@index([productId])
  @@index([buyerCategory])
}

// ============================================
// INVENTORY SCHEMA
// ============================================

model Warehouse {
  id          String @id @default(cuid())
  name        String @unique
  location    String
  address     String
  city        String
  state       String
  capacity    Float
  isActive    Boolean @default(true)
  inventoryLevels InventoryLevel[]

  @@index([city])
  @@index([state])
}

model InventoryLevel {
  id          String @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantityOnHand   Int
  quantityReserved Int   @default(0)
  quantityAvailable Int  @default(0)
  minThreshold Int   @default(10)
  reorderQuantity Int @default(50)
  lastRestockDate DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model InventoryMovement {
  id          String @id @default(cuid())
  productId   String
  warehouseId String
  movementType InventoryMovementType
  quantity    Int
  reference   String
  notes       String?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([reference])
}

enum InventoryMovementType {
  INBOUND
  OUTBOUND
  RETURN
  ADJUSTMENT
  DAMAGE
  SHRINKAGE
}

// ============================================
// ORDER SCHEMA
// ============================================

model Order {
  id                    String    @id @default(cuid())
  orderNumber           String    @unique
  buyerId               String
  buyer                 Buyer     @relation(fields: [buyerId], references: [id])
  status                OrderStatus @default(PENDING)
  subtotal              Float
  vatAmount             Float
  deliveryFee           Float
  total                 Float
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(PENDING)
  paymentTransactionId  String?
  deliveryZone          String?
  deliveryAddressId     String?
  deliveryDate          DateTime?
  notes                 String?
  cancelReason          String?
  items                 OrderItem[]
  orderTimeline         OrderTimeline[]
  invoiceGenerated      Boolean @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([buyerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  discount  Float   @default(0)
  subtotal  Float

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
  WALLET
  CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime @default(now())
  createdBy String?

  @@index([orderId])
  @@index([status])
}

// ============================================
// PAYMENT SCHEMA
// ============================================

model PaymentTransaction {
  id              String  @id @default(cuid())
  orderId         String
  amount          Float
  currency        String  @default("NGN")
  paymentMethod   PaymentMethod
  provider        String
  status          PaymentStatus
  providerRef     String?
  providerResponse String?
  processedAt     DateTime?
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([providerRef])
}

model BankTransfer {
  id              String @id @default(cuid())
  orderId         String
  amount          Float
  bankName        String
  accountName     String
  accountNumber   String
  transactionRef  String?
  verified        Boolean @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([transactionRef])
}

// ============================================
// NOTIFICATIONS SCHEMA
// ============================================

model Notification {
  id        String @id @default(cuid())
  recipientId String
  type      NotificationType
  title     String
  message   String
  data      String?
  isRead    Boolean @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([recipientId])
  @@index([type])
  @@index([isRead])
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  LOW_STOCK_ALERT
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  SYSTEM_ALERT
}

model EmailLog {
  id        String @id @default(cuid())
  recipient String
  subject   String
  template  String
  orderId   String?
  buyerId   String?
  status    EmailStatus
  errorMsg  String?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([recipient])
  @@index([status])
  @@index([orderId])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

model SMSLog {
  id        String @id @default(cuid())
  recipient String
  message   String
  orderId   String?
  buyerId   String?
  status    SMSStatus
  providerRef String?
  errorMsg  String?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([recipient])
  @@index([status])
  @@index([orderId])
}

enum SMSStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

// ============================================
// DELIVERY & LOGISTICS SCHEMA
// ============================================

model DeliveryZone {
  id            String  @id @default(cuid())
  name          String  @unique
  baseFee       Float
  perKmFee      Float   @default(0)
  estimatedDays Int
  states        String[]
  isActive      Boolean @default(true)

  @@index([isActive])
}

// ============================================
// ANALYTICS SCHEMA
// ============================================

model DailySales {
  id          String @id @default(cuid())
  date        DateTime
  totalOrders Int
  totalRevenue Float
  totalUnits  Int
  createdAt   DateTime @default(now())

  @@unique([date])
  @@index([date])
}

model ProductAnalytics {
  id              String @id @default(cuid())
  productId       String
  date            DateTime
  unitsSold       Int
  revenue         Float
  viewCount       Int @default(0)
  addToCartCount  Int @default(0)

  @@unique([productId, date])
  @@index([productId])
  @@index([date])
}
